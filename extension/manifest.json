{
    "manifest_version": 3,
    "name": "UK Job Agent - Auto Application Assistant",
    "version": "0.1.0",
    "description": "Automatically fill UK job applications with AI-generated answers",
    
    "permissions": [
      "storage",
      "activeTab",
      "scripting"
    ],
    
    "host_permissions": [
      "https://*.myworkdayjobs.com/*",
      "https://boards.greenhouse.io/*",
      "https://jobs.lever.co/*",
      "https://*.smartrecruiters.com/*",
      "http://localhost:8000/*"
    ],
    
    "background": {
      "service_worker": "background/service-worker.js"
    },
    
    "content_scripts": [
      {
        "matches": [
          "https://*.myworkdayjobs.com/*"
        ],
        "js": ["content/form-analyzer.js", "content/workday-handler.js"],
        "run_at": "document_idle"
      },
      {
        "matches": [
          "https://boards.greenhouse.io/*"
        ],
        "js": ["content/form-analyzer.js", "content/greenhouse-handler.js"],
        "run_at": "document_idle"
      },
      {
        "matches": [
          "https://jobs.lever.co/*"
        ],
        "js": ["content/form-analyzer.js", "content/lever-handler.js"],
        "run_at": "document_idle"
      }
    ],
    
    "action": {
      "default_popup": "popup/popup.html",
      "default_icon": {
        "16": "assets/icons/icon-16.png",
        "32": "assets/icons/icon-32.png",
        "48": "assets/icons/icon-48.png",
        "128": "assets/icons/icon-128.png"
      }
    },
    
    "icons": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    },
    
    "web_accessible_resources": [
      {
        "resources": ["assets/*"],
        "matches": ["<all_urls>"]
      }
    ]
  }
  