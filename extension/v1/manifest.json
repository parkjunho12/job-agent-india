{
    "manifest_version": 3,
    "name": "Job Agent - Auto Application Helper",
    "version": "1.0.0",
    "description": "Save and analyze job postings from Naukri, LinkedIn with AI",
    
    "permissions": [
      "storage",
      "activeTab",
      "scripting",
      "tabs"
    ],
    
    "host_permissions": [
      "https://*.naukri.com/*",
      "https://*.linkedin.com/*",
      "http://localhost:3000/*",
      "http://localhost:8000/*"
    ],
    
    "background": {
      "service_worker": "background/service-worker.js"
    },
    
    "content_scripts": [
      {
        "matches": ["http://localhost:3000/*"],
        "js": ["content/bridge.js"],
        "run_at": "document_end"
      },
      {
        "matches": ["https://*.naukri.com/*"],
        "js": ["utils/api-client.js", "content/naukri-handler.js"],
        "css": ["styles/overlay.css"],
        "run_at": "document_idle"
      },
      {
        "matches": ["https://*.linkedin.com/jobs/*"],
        "js": ["utils/api-client.js", "content/linkedin-handler.js"],
        "css": ["styles/overlay.css"],
        "run_at": "document_idle"
      }
    ],
    
    "action": {
      "default_popup": "popup/popup.html",
      "default_icon": {
        "16": "assets/icons/icon-16.png",
        "32": "assets/icons/icon-32.png",
        "48": "assets/icons/icon-48.png",
        "128": "assets/icons/icon-128.png"
      }
    },
    
    "icons": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    },
    
    "web_accessible_resources": [
      {
        "resources": ["assets/*", "styles/*"],
        "matches": ["<all_urls>"]
      }
    ]
  }